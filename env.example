# .env 서식.  이 파일을 `.env` 로 복사한 뒤 값을 채운다.
#
# 실제 열쇠는 저장소에 올리지 않는다. `.gitignore` 가 `.env` 를 막고 있다.
# 이 파일은 "무엇이 필요한가" 만 알리는 빈 서식이고 값이 없다.
#
# 평가는 우리가 띄운 서버에 GET 을 보내는 방식이라 심사자가 이 열쇠를
# 넣을 일은 없다. 코드를 처음부터 다시 돌려 볼 때만 필요하다.

# HyperCLOVA X — 답변 생성. 대회 규칙상 생성 모델은 이것만 쓴다
CLOVA_API_KEY=

# CLOVA 임베딩 v2 — 검색용 벡터를 만들 때 쓴다
CLOVA_EMB_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2
CLOVA_EMB_DIM=1024

# 검색용 임베딩. 대회 규칙에서 임베딩은 제약 대상이 아니다
# (제약은 생성 모델에만 걸린다)
OPENAI_API_KEY=

# 아래는 값이 없으면 기본값을 쓴다. 바꿀 일이 없으면 비워 둔다
# CLOVA_CHAT_KEY=      비우면 CLOVA_API_KEY 를 쓴다
# CLOVA_CHAT_HOST=     기본 https://clovastudio.stream.ntruss.com
# CLOVA_CHAT_MODEL=    기본 HCX-005
